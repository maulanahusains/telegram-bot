APP_NAME=telegram-bot-platform
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0

PUBLIC_BASE_URL=https://your-domain.com
# Optional extra hostnames accepted by the Vite development server, comma-separated.
# PUBLIC_BASE_URL's hostname is accepted automatically.
VITE_ALLOWED_HOSTS=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/telegram_platform
POSTGRES_DB=telegram_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

LOG_LEVEL=INFO

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

TELEGRAM_HTTP_TIMEOUT=10
TELEGRAM_HTTP_CONNECT_TIMEOUT=5
TELEGRAM_HTTP_MAX_CONNECTIONS=100
TELEGRAM_HTTP_KEEPALIVE_CONNECTIONS=20
TELEGRAM_SAFE_RETRY_ATTEMPTS=3

WEBHOOK_BODY_LIMIT_BYTES=1048576
UPDATE_MAX_ATTEMPTS=3
UPDATE_LEASE_SECONDS=60
STATE_CONFLICT_RETRIES=5

STARTUP_DB_MAX_ATTEMPTS=5
STARTUP_DB_BACKOFF_SECONDS=1

# Telegram Mini App/platform session authentication.
TELEGRAM_WEB_APP_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_WEB_APP_CLOCK_SKEW_SECONDS=30
APPLICATION_SESSION_TTL_SECONDS=86400
APPLICATION_SESSION_COOKIE_NAME=telegram_platform_session
# Keep true in production. Set false only for explicit local HTTP development.
APPLICATION_SESSION_COOKIE_SECURE=true
# Telegram Web may embed the Mini App cross-site; keep this `none` together
# with the required Secure=true setting. For explicit local HTTP-only work,
# use `lax` and set Secure=false in the untracked local .env.
APPLICATION_SESSION_COOKIE_SAMESITE=none

# Life reminder executor. Enable in exactly one designated application process.
LIFE_REMINDER_EXECUTOR_ENABLED=false
LIFE_REMINDER_EXECUTOR_INTERVAL_SECONDS=30
LIFE_REMINDER_EXECUTOR_BATCH_SIZE=50
LIFE_REMINDER_CLAIM_LEASE_SECONDS=120
LIFE_REMINDER_MAX_ATTEMPTS=3
LIFE_REMINDER_RETRY_BASE_SECONDS=60
LIFE_REMINDER_ONE_TIME_GRACE_SECONDS=3600

# Deterministic weight-trend calorie recommendations. Keep disabled until manually verified.
LIFE_GOAL_RECOMMENDATIONS_ENABLED=false
LIFE_GOAL_RECOMMENDATION_CADENCE_DAYS=1
LIFE_GOAL_RECOMMENDATION_WINDOW_DAYS=21
LIFE_GOAL_RECOMMENDATION_MIN_OBSERVATIONS=14
LIFE_GOAL_RECOMMENDATION_MAX_GAP_DAYS=4
LIFE_GOAL_RECOMMENDATION_COOLDOWN_DAYS=14
LIFE_GOAL_RECOMMENDATION_EXPIRY_DAYS=7
LIFE_GOAL_RECOMMENDATION_DELTA_KCAL=100
LIFE_GOAL_RECOMMENDATION_TOLERANCE_KG_PER_WEEK=0.10

# Gitlab OPS settings
GITLAB_OPS_EXECUTOR_ENABLED=true
GITLAB_OPS_EXECUTOR_INTERVAL_SECONDS=15
GITLAB_OPS_EXECUTOR_BATCH_SIZE=50

# Public, non-secret frontend ports used by the root Compose profiles.
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For rotation, put the newest key first and separate keys with commas.
BOT_CREDENTIAL_KEYS=replace-with-a-valid-fernet-key

# Generate a long random value and use it as Bearer token in Swagger.
ADMIN_API_KEY=replace-with-a-long-random-admin-api-key

# Token for the Cloudflare Tunnel container in the Compose dev profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
